{
    "name": "ref-it/elsa",
    "type": "project",
    "description": "Electronic voting system",
    "keywords": ["laravel", "framework"],
    "license": "EUPL-1.2-or-later",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "ext-ldap": "*",
        "ext-pdo": "*",
        "directorytree/ldaprecord-laravel": "^4.0",
        "firebase/php-jwt": "^7.0",
        "kovah/laravel-socialite-oidc": "^0.8.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/flux": "^2.14",
        "livewire/flux-pro": "^2.14",
        "livewire/livewire": "^4.0",
        "mews/purifier": "^3.4"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": [
            "@php artisan test"
        ],
        "fix": [
            "@php vendor/bin/rector process",
            "@php vendor/bin/pint"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the Pest test suite",
        "fix": "Apply Rector refactorings, then format with Pint"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [{
        "name": "flux-pro",
        "type": "composer",
        "url": "https://composer.fluxui.dev"
    }]
}
